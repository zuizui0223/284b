{
  "overlay_version": "product_b_v7_differentiability_overlay_v0.1",
  "applies_to_contract": "product_b_v7_literature_witness_v0.1",
  "frozen_before_any_v7_occurrence_or_invariant_read": true,
  "stage_1_pre_occurrence": {
    "name": "response_blind_library_structural_differentiability",
    "minimum_structural_members": 2,
    "minimum_unique_procedures": 2,
    "minimum_distinct_selected_predictor_signatures": 2,
    "every_declared_process_requires_at_least_one_structurally_admissible_knockout_member": true,
    "candidate_scores_may_be_read": false,
    "ecological_recovery_values_may_be_read": false,
    "sealed_values_may_be_read": false
