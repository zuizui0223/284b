  "stage_2_post_host_fit_pre_invariant": {
    "name": "host_specific_adequate_set_differentiability",
    "minimum_adequate_members": 2,
    "minimum_distinct_selected_predictor_signatures_among_adequate_members": 2,
    "all_declared_processes_must_remain_structurally_knockout_admissible_in_at_least_one_adequate_member": true,
    "if_failed": "unresolved_model_pool_differentiability",
