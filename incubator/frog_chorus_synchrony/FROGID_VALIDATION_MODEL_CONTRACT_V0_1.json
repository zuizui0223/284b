{
  "project": "frog-chorus-synchrony",
  "external_validation": "FrogID",
  "model_contract_version": "0.1",
  "status": "frozen_before_ERA5_weather_opening",
  "structural_receipts": [
    "FROGID_STRUCTURAL_RECEIPT_V0_3.json",
    "FROGID_WEATHER_LINK_CONTRACT_V0_1.json"
  ],
  "source_pins": {
    "FrogID_DwCA": "f5dd70ed07956e3e37de4fb04692b83a9d726eae2312767c9eda2dcbf61f759d"
  },
  "deterministic_sample": {
    "rule": "SHA256(eventID)[0] < 16",
    "retained_recordings": 40754,
    "multispecies_recordings": 18174,
    "weather_cells_0p25deg": 1623,
    "max_coordinate_uncertainty_m": 25000
  },
  "weather": {
    "provider": "Open-Meteo Historical Weather API",
    "underlying_model": "ERA5",
    "model_parameter": "era5",
    "spatial_resolution": "0.25 degree",
    "daily_variable": "precipitation_sum",
    "timezone": "auto",
    "cell_selection": "nearest",
    "elevation": "nan",
    "retrieval_window": [
      "2017-10-01",
      "2024-11-09"
    ],
    "wet_day_threshold_mm": 1,
    "event_day_excluded": true,
    "exposure_definition": "consecutive preceding local-calendar dry days (<1 mm/day) before eventDate, capped at 30; 0 means the previous day was wet",
    "exposure_transform": "zscore(log1p(dry_days))"
  },
  "response": {
    "unit": "eventID recording",
    "binary": "1 when recording contains >=2 distinct calling species; 0 when exactly 1",
    "interpretation": "conditional probability of a multi-species chorus among submitted expert-validated frog recordings",
    "not_presence_absence": true
  },
  "primary_model": {
    "family": "binomial_logit",
    "formula": "multi ~ dry_z + C(state) * C(month) + year_z + sin_hour + cos_hour",
    "primary_term": "dry_z",
    "directional_hypothesis": "beta_dry < 0",
    "covariance": "cluster_robust",
    "cluster": "ERA5 0.25-degree weather cell",
    "support_rule": "beta_dry < 0 AND two-sided p < 0.05 AND 95% CI excludes 0"
  },
  "frozen_sensitivities": [
    {
      "name": "high_coordinate_precision",
      "filter": "coordinateUncertaintyInMeters <= 10000",
      "same_formula": true,
      "same_cell_cluster": true
    },
    {
      "name": "recorder_cluster",
      "filter": "same primary sample",
      "same_formula": true,
      "covariance": "cluster_robust by recordedBy"
    }
  ],
  "prohibited_after_opening": [
    "change 1/16 hash sample",
    "change 25 km coordinate filter",
    "change 1 mm wet-day threshold",
    "include event-day rainfall",
    "change dry-day cap from 30",
    "select a state, month, species pair, or richness threshold because it is stronger",
    "replace NAAMP primary with FrogID if FrogID effect is larger",
    "claim rainfall is causal"
  ],
  "validation_effect_opened": false
}
